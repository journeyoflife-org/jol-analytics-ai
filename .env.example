# Application
APP_NAME=jol-analytics-ai
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/jol_analytics

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ML Models
MODEL_REGISTRY_PATH=./artifacts/models
MODEL_VERSION=1.0.0

# RAG / Vector Store
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=jol_documents
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Airflow
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__DAGS_FOLDER=./src/jol_analytics_ai/airflow/dags

# GDPR Compliance
ANONYMIZATION_K_VALUE=5
PII_DETECTION_ENABLED=true
DATA_RETENTION_DAYS=365

# API
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS='["http://localhost:3000"]'
